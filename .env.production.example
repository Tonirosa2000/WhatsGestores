# ===============================================
# CONFIGURAÇÃO DE PRODUÇÃO - WHATSGESTORES VPS
# ===============================================

# 1. Chave da Inteligência Artificial do Google Gemini (Obrigatório)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# 2. Banco de Dados SQLite (Persistido via Docker Volume)
DATABASE_URL="file:/app/prisma/dev.db"

# 3. URL Pública do WhatsGestores (IP da VPS ou Domínio)
# Exemplo com IP: http://179.199.143.195:3000
# Exemplo com Domínio: https://vagas.seudominio.com.br
NEXT_PUBLIC_APP_URL="http://179.199.143.195:3000"

# 4. Configurações da Evolution API (Robô WhatsApp)
EVOLUTION_API_KEY="whatsgestores_chave_segura_2026"
EVOLUTION_PUBLIC_URL="http://179.199.143.195:8080"