# ========================================================
# WHATSGESTORES - VARIÁVEIS DE AMBIENTE (.env)
# ========================================================

# 1. Chave da API do Google Gemini (Google AI Studio)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. Configurações do Supabase (Nuvem)
# Obtenha em: Supabase Dashboard -> Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-do-supabase"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# 3. String de Conexão do Banco de Dados (Prisma ORM)
# Para desenvolvimento local: "file:./dev.db"
# Para produção no Supabase: "postgresql://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="file:./dev.db"

# 4. Nomes dos Grupos Oficiais do WhatsApp
WHATSAPP_GROUP_VAGAS="Gestores - Banco de Talentos - VAGAS"
WHATSAPP_GROUP_CURRICULOS="Gestores - Banco de Talentos - Currículos"

# 5. Nome da Aplicação
NEXT_PUBLIC_APP_NAME="WhatsGestores"
